# Exported GGUF weight bundles served by /models. These are build outputs from
# the android repo's export step (8.8 GB at three profiles) and are deployed
# out of band, not through git. MODEL_ARTIFACT_ROOT points at wherever they
# actually live.
app/models/

# Google Play service-account keys. PLAY_SERVICE_ACCOUNT_FILE should point
# outside the repo, but a key committed by accident is a key that must be
# rotated, so the usual names are refused here too.
*service-account*.json
play-*.json

.DS_Store
