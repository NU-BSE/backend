APP_ENV=development
APP_DEBUG=true
APP_NAME=Attestation API
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

DATABASE_URL=postgresql+asyncpg://attestation:attestation@localhost:5432/attestation
REDIS_URL=redis://localhost:6379/0

# Main application authentication. Do not use x-user-id.
AUTH_JWT_SECRET=replace-with-at-least-32-random-bytes
AUTH_JWT_ISSUER=attestation-local
AUTH_JWT_AUDIENCE=attestation-api
ALLOW_DEV_TOKEN_ENDPOINT=true

NONCE_TTL_MS=90000
MAX_ATTESTED_LATENCY_MS=2500

ANDROID_PACKAGE_NAME=com.attestation.security
ANDROID_CERT_SHA256=
PLAY_INTEGRITY_PROJECT_NUMBER=
GOOGLE_SERVICE_ACCOUNT_FILE=
ANDROID_ATTESTATION_ROOT_SHA256=

JIT_PRIVATE_KEY_FILE=./secrets/jit-ed25519-private.pem
JIT_KID=jit-dev-2026-01
JIT_API_AUDIENCE=sensitive-api
JIT_TTL_RESTRICTED_SECONDS=60
JIT_TTL_STANDARD_SECONDS=120
JIT_TTL_ELEVATED_SECONDS=120
JIT_TTL_HIGHEST_SECONDS=180

VELOCITY_BURST_REQUESTS_PER_MINUTE=30
VELOCITY_IP_HOPPING_DISTINCT_IPS_1H=5
VELOCITY_ASN_HOPPING_DISTINCT_ASNS_1H=2
VELOCITY_LOW_ENTROPY_BITS_PER_SYMBOL=2.0
