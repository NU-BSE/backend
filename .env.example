APP_ENV=development
APP_DEBUG=true
APP_NAME=Creepy.IM API
CORS_ORIGINS=http://localhost:8081,http://localhost:5173

# Postgres (docker compose service below) or any asyncpg URL.
DATABASE_URL=postgresql+asyncpg://creepy:creepy@localhost:5432/creepy
# Empty -> in-process TTL store (dev only; use Redis for anything real).
REDIS_URL=redis://localhost:6379/0

# Auth. At least 32 random bytes, e.g.: openssl rand -hex 32
JWT_SECRET=replace-with-at-least-32-random-bytes
JWT_ISSUER=creepy-im
JWT_AUDIENCE=creepy-im-api
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# Comma-separated emails allowed to call /admin/grant.
ADMIN_EMAILS=

# Store-review demo accounts: comma-separated emails that hold the full product
# with no subscription and no payment. Google Play requires working credentials
# for anything behind a login, and a reviewer cannot be asked to buy.
#
# Empty by default, and it must stay empty everywhere except the deployment the
# reviewers actually use — an address listed here gets the paid product for
# free, so treat it as a credential, not a config value. Keep it DISJOINT from
# ADMIN_EMAILS: these credentials are published to strangers and must not also
# unlock /admin/grant.
#
# These accounts also SIGN IN WITHOUT A CODE: request-code returns a session
# directly instead of emailing a challenge, because a reviewer cannot read the
# mailbox. The name is the second half of the credential: it is matched
# exactly, case included, and the wrong name falls through to the ordinary
# code flow rather than saying so.
#
# Format: comma-separated email:Name pairs.
#   DEMO_ACCOUNTS=admin@creepy.im:Admin349401
DEMO_ACCOUNTS=

# Email-code challenges.
EMAIL_CODE_TTL_SECONDS=300
EMAIL_CODE_RESEND_COOLDOWN_SECONDS=60
EMAIL_CODE_MAX_PER_EMAIL_PER_HOUR=5
EMAIL_CODE_MAX_PER_IP_PER_HOUR=20
EMAIL_CODE_MAX_VERIFY_ATTEMPTS=5

# Brevo transactional + Events/Contacts API. Generate an API key in Brevo's
# SMTP & API settings. Keep this server-side; never expose it in VITE_ vars.
BREVO_API_KEY=
# List that receives landing-page Android invitation requests.
BREVO_CONTACT_LIST_ID=2
# Suppress quick duplicate submissions and cap abusive public requests.
MARKETING_INVITE_COOLDOWN_SECONDS=60
MARKETING_INVITE_MAX_PER_IP_PER_HOUR=30
# Must be a sender/domain verified in Brevo.
EMAIL_FROM=Creepy.IM <no-reply@creepy.im>

# Cloud agent upstream (OpenAI-compatible chat completions endpoint).
# LLM_MOCK=true streams a canned reply without calling anything.
LLM_UPSTREAM_URL=
LLM_UPSTREAM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=120
LLM_MOCK=true

# OpenRouter tiered model routing.
# Each tier maps to an OpenRouter model ID (e.g. "openai/gpt-4o", "anthropic/claude-3-sonnet").
OPENROUTER_API_KEY=
LLM_MODEL_FAST=
LLM_MODEL_NORMAL=
LLM_MODEL_EXPERT=

LLM_NORMAL_SCORE_THRESHOLD=4
LLM_EXPERT_SCORE_THRESHOLD=10

LLM_ALLOW_EXPERT=true
LLM_EXPERT_DAILY_USER_LIMIT=20
LLM_EXPERT_MAX_CALLS_PER_RUN=3

LLM_REQUEST_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# --- Google Play Billing --------------------------------------------------
# The service account needs "View financial data" in the Play Console and must
# be linked to the app. Prefer the file: pasting the key into JSON puts it in
# `docker inspect` output.
PLAY_PACKAGE_NAME=im.creepy.app
PLAY_SERVICE_ACCOUNT_FILE=
PLAY_SERVICE_ACCOUNT_JSON=
PLAY_API_TIMEOUT_SECONDS=20
# Shared secret for /subscriptions/play/rtdn. Configure the Pub/Sub push
# subscription to send `Authorization: Bearer <this>`. Without it the endpoint
# refuses everything: an open webhook lets anyone forge a renewal.
# Generate with: openssl rand -hex 32
PLAY_RTDN_SECRET=

# --- On-device model weights ----------------------------------------------
# Where the exported GGUF bundles live, as written by the android export step.
MODEL_ARTIFACT_ROOT=app/models
# Downloads require a live paid subscription. Only turn this off locally.
MODEL_DOWNLOAD_REQUIRES_ENTITLEMENT=true

# --- Cloud agent on llama.cpp ---------------------------------------------
# Start with scripts/llama_up.sh, which picks CUDA or CPU by probing the host,
# then point the upstream at whichever profile came up:
#   LLM_UPSTREAM_URL=http://llama-gpu:8080/v1/chat/completions
#   LLM_MODEL=gui-owl-1.5-2b-chat
#   LLM_MOCK=false
LLAMA_QUANT=Q4_K_M
LLAMA_CTX_SIZE=8192
# Defaults to ../android/artifacts/adapters/chat relative to this repo.
LLAMA_ADAPTER_PATH=
# Only needed if the base model repo is gated.
HF_TOKEN=

# Device-bound model licensing.
# LICENSE_SIGNING_KEY is an RSA private key in PEM. Asymmetric on purpose: the
# app verifies licences, so whatever verifies them ships in the app — an HMAC
# secret would be extractable from any build and would let its holder mint
# licences. The app carries only the public half.
LICENSE_SIGNING_KEY=
# {"v1": "<base64 32-byte AES key>"} — one key per model version. Removing a
# version revokes it: the server simply stops issuing licences for it.
MODEL_KEYS_JSON=
# Demand MEETS_STRONG_INTEGRITY instead of MEETS_DEVICE_INTEGRITY. Excludes a
# lot of otherwise-legitimate mid-range hardware, so default off.
REQUIRE_STRONG_INTEGRITY=false
